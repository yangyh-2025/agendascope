# AgendaScope 观澜 — 前端生产镜像（多阶段：node 构建 → nginx 托管）
#
# 阶段 1: node:20 构建 Vite 产物（frontend/dist）
#   - 默认 npm 镜像 npmmirror（国内服务器可达）；可通过 --build-arg NPM_REGISTRY 覆盖
# 阶段 2: nginx:1.27-alpine 托管 dist + 反代 /api → backend:8000 + HTTPS
#
# 用法（compose 服务 frontend build 或手动）:
#   docker build -f deploy/Dockerfile.frontend -t agendascope-frontend:latest frontend/

# ---------- 阶段 1: 构建 ----------
FROM node:20-alpine AS builder

ARG NPM_REGISTRY=https://registry.npmmirror.com
WORKDIR /app

# 先拷 package 文件装依赖（利用层缓存，源码变更不重复 npm ci）
COPY package.json package-lock.json* ./
RUN npm config set registry "${NPM_REGISTRY}" \
    && npm ci --no-audit --no-fund || npm install --no-audit --no-fund

# 拷源码并构建
COPY . .
RUN npm run build

# ---------- 阶段 2: nginx 托管 ----------
FROM nginx:1.27-alpine

# 托管 Vite 构建产物（SPA 回退 + /api 反代 + HTTPS 由 nginx.conf 配置，
# 该配置经 compose 卷挂载到 /etc/nginx/conf.d/default.conf，支持热更新）
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80 443
CMD ["nginx", "-g", "daemon off;"]
