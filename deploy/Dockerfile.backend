# AgendaScope 观澜 后端镜像（api_server 与采集 worker 共用）
FROM python:3.11-slim

# 构建期代理（离线/受限网络构建时经 --build-arg 注入；默认空=直连）
ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ARG NO_PROXY=""
# apt 源镜像（默认官方源；受限网络可传 --build-arg APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn）
ARG APT_MIRROR=""
# pip 索引镜像（默认官方 PyPI；受限网络可传 --build-arg PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple）
ARG PIP_INDEX_URL=""
# Playwright 浏览器下载镜像（默认官方 CDN；受限网络可传 npmmirror）
ARG PLAYWRIGHT_DOWNLOAD_HOST=""
# torch 安装索引（默认 CPU-only wheel，省 ~2GB CUDA 库；GPU 机器可传官方 CUDA index）
ARG PIP_TORCH_INDEX="https://download.pytorch.org/whl/cpu"
ENV HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY} NO_PROXY=${NO_PROXY}
ENV PIP_INDEX_URL=${PIP_INDEX_URL} PLAYWRIGHT_DOWNLOAD_HOST=${PLAYWRIGHT_DOWNLOAD_HOST}

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN if [ -n "$APT_MIRROR" ]; then \
      sed -i "s|http://deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
    fi

COPY requirements.txt .
# 先装 CPU-only torch（本机纯 CPU 推理），避免 requirements.txt 里 torch 拉入 CUDA 全家桶
RUN pip install torch --index-url "$PIP_TORCH_INDEX"
RUN pip install -r requirements.txt

# Playwright 无头浏览器（pipeline 反爬渲染抓取用；仅 chromium 减体积）
RUN playwright install --with-deps chromium

COPY . .

# 运行期不继承构建期代理
ENV HTTP_PROXY="" HTTPS_PROXY="" NO_PROXY=""

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
