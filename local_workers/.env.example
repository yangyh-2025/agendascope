# AgendaScope 本地算力机 worker 环境变量
# 用法：cp .env.example .env，填入实际值

# ============================================
# 云端 PostgreSQL（39.106.2.28:5432，SSL 强制）
# ============================================
# 格式：postgresql+psycopg2://USER:PASSWORD@HOST:5432/DB?sslmode=require&sslrootcert=path
# 首次部署需要：
#   1) 服务器跑 deploy/postgresql/generate_ssl_cert.sh 生成证书
#   2) 把 deploy/postgresql/ssl/ca.crt 复制到本地 ./ssl/ca.crt
#   3) 服务器跑 deploy/postgresql/init_public_users.sql 创建 agendascope_write 账号
DATABASE_URL=postgresql+psycopg2://agendascope_write:CHANGE_ME@39.106.2.28:5432/agendascope?sslmode=require&sslrootcert=/app/ssl/ca.crt

# ============================================
# 采集代理（本地 mihomo/Clash 代理，408 媒体源多在国外）
# ============================================
# 本地 mihomo 监听 7890，http 代理
GLOBAL_SITE_PROXY=http://host.docker.internal:7890
# 如果是 Linux Docker 旧版本，用 172.17.0.1 替代 host.docker.internal

# ============================================
# LLM 云 API（关系抽取 / 命名 / 分类 / 摘要）
# ============================================
# 单模型（兜底）
LLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=CHANGE_ME
LLM_API_MODEL=glm-4-flash

# 多模型池（可选，JSON 数组，与云端 .env 一致）
LLM_POOL=

# ============================================
# 采集调优
# ============================================
CRAWL_TIMEOUT_SECONDS=30
COLLECT_MAX_WORKERS=8

# ============================================
# SMTP（预警邮件，可选）
# ============================================
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=alert@agendascope.local
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=
