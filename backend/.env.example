# AgendaScope 观澜 后端配置示例（复制为 .env 使用，.env 不入库）
APP_NAME=AgendaScope
APP_ENV=dev
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# 数据库（PostgreSQL 16 + pgvector）
DATABASE_URL=postgresql+psycopg2://agenda:agenda_dev_pwd@localhost:5432/agendascope

# Redis（db0=缓存/去重，db1=队列 Streams）
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_URL=redis://localhost:6379/1

# Elasticsearch 8
ELASTICSEARCH_URL=http://localhost:9200

# JWT（生产必须修改）
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_MINUTES=720

# 采集端接入中枢的内部 token（与 JWT 用户体系分离，生产必须修改）
COLLECTOR_INTERNAL_TOKEN=change-me-internal-collector-token

# 采集调度
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
DEFAULT_CRAWL_INTERVAL_SECONDS=900
GDELT_ENABLED=true
GDELT_INTERVAL_SECONDS=900
GDELT_API_BASE=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_COUNTRIES=US,GB,CN,JP,RU,DE,FR,KR,TR,QA,CA,AU,ES
GDELT_MAX_RECORDS=50

# RSSHub 自建实例（独立容器进程隔离，AGPL-3.0 合规；补无原生 RSS 站点）
RSSHUB_BASE=http://localhost:1200

# 采集中枢地址（collector 提交 CollectedData 的目标）
COLLECT_API_BASE=http://localhost:8000

# 代理分级（国内外分流，经部署方批准的边界出口；留空为直连）
GLOBAL_SITE_PROXY=
CN_SITE_PROXY=

# 抓取行为
CRAWL_TIMEOUT_SECONDS=30
CRAWL_MAX_RETRIES=3
CRAWL_USER_AGENT=AgendaScopeBot/1.0 (+https://agendascope.local/bot)

# 治理与告警
SOURCE_FAIL_RATE_ALERT_THRESHOLD=0.10
SOURCE_FAIL_RATE_WINDOW_HOURS=24

# 登录限流与锁定
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15

# 初始管理员（种子脚本使用，首次登录强制改密）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin12345

# NLP 管线（backend/app/nlp/config.py，NLP_ 前缀）
NLP_MODEL_DIR=../models
NLP_EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
NLP_DEVICE=cpu
NLP_EMBED_BATCH_SIZE=32
NLP_LANG_CONFIDENCE_THRESHOLD=0.8
NLP_ES_INDEX=agendascope_articles
NLP_ES_MAX_RETRIES=5
NLP_WORKER_BATCH_SIZE=32
NLP_WORKER_BLOCK_MS=5000
NLP_WORKER_MAX_ATTEMPTS=8

# 聚类引擎（backend/app/clustering/config.py，CLUSTER_ 前缀）
CLUSTER_T_EVENT=0.85
CLUSTER_T_DUP=0.95
CLUSTER_BERTOPIC_MIN_CLUSTER_SIZE=10
CLUSTER_BERTOPIC_MIN_COHESION=0.5
CLUSTER_MAX_BERTOPIC_CLUSTER_SHARE=0.8
CLUSTER_AGGLOMERATIVE_DISTANCE_THRESHOLD=0.25
CLUSTER_CONFIRMED_MIN_SIZE=10
CLUSTER_UNCLASSIFIED_TTL_HOURS=48
CLUSTER_RECLUSTER_INTERVAL_MINUTES=60
CLUSTER_RECLUSTER_WINDOW_HOURS=24
CLUSTER_KEYWORD_MIN_OVERLAP=2
CLUSTER_WORKER_BATCH_SIZE=32
CLUSTER_WORKER_BLOCK_MS=5000
CLUSTER_WORKER_MAX_ATTEMPTS=8

# LLM 服务（backend/app/llm/settings.py，LLM_ 前缀；模型权重放仓库根 models/，不入库）
LLM_PROFILE=cpu-dev
# LLM_MODEL_DIR=../models/Qwen2.5-0.5B-Instruct   # 留空按配置档默认；可覆盖模型目录
# LLM_DEVICE=cpu
LLM_MAX_CONTEXT_TOKENS=2000
LLM_FAILURE_RATE_THRESHOLD=0.2
# LLM_CATEGORIES=["政治安全","经济金融","军事","科技","能源气候","社会民生","其他"]
LLM_NAMING_WORKER_BATCH_SIZE=20
LLM_NAMING_WORKER_POLL_SECONDS=30
LLM_NAMING_WORKER_RETRY_COOLDOWN_SECONDS=600
